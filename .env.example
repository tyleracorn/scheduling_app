# Database (local pnpm dev via docker-compose.dev.yml, user/password cabin)
DATABASE_URL=postgresql://cabin:cabin@localhost:5432/cabin_scheduling

# Required by docker-compose.yml. The dev database above stays cabin/cabin.
# If a volume was already created with the old hardcoded password, set this to cabin
# so it matches that database.
POSTGRES_USER=cabin
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=cabin_scheduling

# Session cookie secret. Required in production. Rotating it does not log people out.
SESSION_SECRET=change-me-to-a-long-random-string

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Set true when one HTTPS reverse proxy is the only way clients reach the app.
# Leave unset for local pnpm dev.
# TRUST_PROXY=true

# API log level: fatal, error, warn, info, debug, trace, or silent
LOG_LEVEL=info

# Seed admin (created on first seed; password not reset on later seeds)
SEED_ADMIN_EMAIL=admin@example.com
# Local seed default. docker-compose.yml requires this variable with no fallback.
# Use a strong password before a production deploy.
SEED_ADMIN_PASSWORD=changeme

# Demo calendar/notes on seed. Leave false; use `pnpm db:seed:demo` when you want sample data.
SEED_DEMO=false

# CSV export directory inside the container (compose mounts EXPORTS_HOST_PATH → /data/exports)
EXPORT_PATH=/data/exports/csv
# Host path for backups parent (csv/ + db/). Local default: ./data/exports
# EXPORTS_HOST_PATH=./data/exports

# SMTP (optional in dev — logs recipient and subject only, not the message body)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
